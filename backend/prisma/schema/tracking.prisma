// ─── GPS Tracking & Session models ───────────────────────────────────────────

model UserSession {
  id          String    @id @default(uuid())
  userId      String?   @map("user_id")
  tourId      String?   @map("tour_id")
  startedAt   DateTime  @default(now()) @map("started_at")
  endedAt     DateTime? @map("ended_at")
  deviceInfo  String?   @map("device_info") @db.VarChar(200)

  user             User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  tour             Tour?              @relation(fields: [tourId], references: [id])
  audioPlayHistory AudioPlayHistory[]

  @@map("user_sessions")
}

model AudioPlayHistory {
  id                   String   @id @default(uuid())
  sessionId            String   @map("session_id")
  poiId                String   @map("poi_id")
  triggeredAt          DateTime @default(now()) @map("triggered_at")
  triggerType          String   @map("trigger_type") @db.VarChar(20)
  playDurationSeconds  Int?     @map("play_duration_seconds")
  totalDurationSeconds Int?     @map("total_duration_seconds")
  completed            Boolean  @default(false)
  stopReason           String?  @map("stop_reason") @db.VarChar(30)

  session UserSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  poi     PointOfInterest @relation(fields: [poiId], references: [id])

  @@index([sessionId, poiId, triggeredAt])
  @@index([poiId])
  @@map("audio_play_history")
}
