# ─── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Public URL used by mobile devices, QR/media URLs, and server logs.
# Use an internet-reachable HTTPS URL in production or when testing outside the same Wi-Fi.
PUBLIC_API_BASE_URL=https://your-public-backend.example.com

# ─── Database ─────────────────────────────────────────
DATABASE_URL="mysql://root:password@localhost:3306/audio_tour_guide"

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET=your-super-secret-key-at-least-32-characters-long
JWT_EXPIRES_IN=7d

# ─── File Upload ──────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/gif

# ─── Email (Nodemailer) ───────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=noreply@yourdomain.com
MAIL_PASS=your-email-password
MAIL_FROM="Audio Tour Guide <noreply@yourdomain.com>"

# ─── Frontend ─────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://your-admin-frontend.example.com

# ─── Monitoring ────────────────────────────────────────
MAX_CONCURRENT_SESSIONS=500
MONITORING_WARNING_THRESHOLD_PERCENT=80

# ─── Rate Limit ───────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
