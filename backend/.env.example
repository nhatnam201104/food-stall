# ─── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=3000
REQUEST_BODY_LIMIT_MB=50

# ─── Database ─────────────────────────────────────────
DATABASE_URL="mysql://root:password@localhost:3306/audio_tour_guide"

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET=your-super-secret-key-at-least-32-characters-long
JWT_EXPIRES_IN=7d

# ─── File Upload ──────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/gif

# ─── Email (Nodemailer) ───────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=noreply@yourdomain.com
MAIL_PASS=your-email-password
MAIL_FROM="Audio Tour Guide <noreply@yourdomain.com>"

# ─── Frontend ─────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Rate Limit ───────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ─── TTS Provider ──────────────────────────────────────
TTS_PROVIDER=xai
TTS_FALLBACK_PROVIDER=google
XAI_API_KEY=your-xai-api-key
XAI_TTS_VOICE_ID=eve
XAI_TRANSLATE_MODEL=grok-4
TTS_FORCE_TRANSLATION_FOR_EXPLICIT_LANGUAGE=true
